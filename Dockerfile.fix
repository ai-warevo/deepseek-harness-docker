# syntax=docker/dockerfile:1.7
ARG BASE_IMAGE=docker.io/runzhliu/deepseek-harness:0.2.2-rc.4-r1
FROM ${BASE_IMAGE}

USER root

# clang-18 + libc++-18 (from trixie, side-by-side with the default clang 19): use `clang++-18 -stdlib=libc++`.
# libc++-18 ships std::jthread/stop_token only behind -fexperimental-library (needed by aw::tpl).
# Install GCC 15 on top of build-essential so gcc/g++ point to the fresh toolchain.
# gcovr must match gcov version — both from forky.
RUN echo 'deb https://deb.debian.org/debian forky main' > /etc/apt/sources.list.d/forky.list && \
    printf 'Package: *\nPin: release n=forky\nPin-Priority: 100\n' > /etc/apt/preferences.d/forky && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        clang \
        clang-18 \
        libc++-18-dev \
        libc++abi-18-dev \
        clang-format \
        clang-tidy \
        cmake \
        gdb \
        gperf \
        git \
        libssl-dev \
        lld \
        ninja-build \
        qrencode \
        zlib1g-dev \
    && \
    apt-get install -y --no-install-recommends -t forky gcc-15 g++-15 gcovr && \
    rm -rf /var/lib/apt/lists/* && \
    ln -sf /usr/bin/gcc-15 /usr/bin/gcc && \
    ln -sf /usr/bin/g++-15 /usr/bin/g++ && \
    g++-15 --version && \
    clang++-18 --version && \
    groupadd -g 1001 docker 2>/dev/null || true && \
    usermod -aG docker node 2>/dev/null || true && \
    \
    # Agent productivity tools (from trixie)
    apt-get update && \
    apt-get install -y --no-install-recommends \
        bat \
        fd-find \
        fzf \
        gh \
        htop \
        zoxide && \
    ln -sf /usr/bin/fdfind /usr/bin/fd && \
    ln -sf /usr/bin/batcat /usr/bin/bat && \
    rm -rf /var/lib/apt/lists/* && \
    npm install -g diff-so-fancy

# GUI Development: X11, OpenGL dev headers, Xvfb (separate layer for caching)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        gperf \
        libx11-dev \
        libxrandr-dev \
        libxinerama-dev \
        libxcursor-dev \
        libxi-dev \
        libgl1-mesa-dev \
        libgl1-mesa-dri \
        libglx-mesa0 \
        libglu1-mesa-dev \
        mesa-common-dev \
        mesa-utils \
        xvfb \
        x11-utils && \
    rm -rf /var/lib/apt/lists/*


# Pre-populate Dear ImGui docking branch (headers only, fast)
# KEEP SOURCE for debugging/inspection
RUN git clone --branch v1.91.8-docking --depth 1 https://github.com/ocornut/imgui.git /opt/deps/src/imgui && \
    mkdir -p /opt/deps/include/imgui && \
    cp /opt/deps/src/imgui/*.h /opt/deps/src/imgui/*.cpp /opt/deps/include/imgui/ && \
    cp /opt/deps/src/imgui/backends/imgui_impl_glfw.* /opt/deps/src/imgui/backends/imgui_impl_opengl3.* /opt/deps/include/imgui/

# Pre-populate development libraries for agent inspection
# Split by ABI: libstdc++ and libc++ versions

# ==== libstdc++ (gcc-15, clang-18 default) ====
# Catch2 v3.6.0 (libstdc++)
RUN cd /opt/deps/src && \
    git clone --branch v3.6.0 --depth 1 https://github.com/catchorg/Catch2.git && \
    cd Catch2 && mkdir build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/deps/libstdc++ -DBUILD_TESTING=OFF && \
    cmake --build . --parallel $(nproc) && \
    cmake --install . && \
    echo 'set(Catch2_SOURCE_DIR "/opt/deps/libstdc++/src/Catch2")' >> /opt/deps/libstdc++/lib/cmake/Catch2/Catch2Config.cmake

# spdlog v1.14.1 (libstdc++)
RUN cd /opt/deps/src && \
    git clone --branch v1.14.1 --depth 1 https://github.com/gabime/spdlog.git && \
    cd spdlog && mkdir build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/deps/libstdc++ -DSPDLOG_BUILD_TESTS=OFF -DSPDLOG_BUILD_EXAMPLE=OFF && \
    cmake --build . --parallel $(nproc) && \
    cmake --install . && \
    rm -rf /opt/deps/src/spdlog

# fmt v11.0.2 (libstdc++)
RUN cd /opt/deps/src && \
    git clone --branch 11.0.2 --depth 1 https://github.com/fmtlib/fmt.git && \
    cd fmt && mkdir build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/deps/libstdc++ -DFMT_TEST=OFF && \
    cmake --build . --parallel $(nproc) && \
    cmake --install . && \
    rm -rf /opt/deps/src/fmt

# GLFW 3.4 (libstdc++)
RUN cd /opt/deps/src && \
    git clone --branch 3.4 --depth 1 https://github.com/glfw/glfw.git glfw-libstdc++ && \
    cd glfw-libstdc++ && mkdir build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/deps/libstdc++ \
        -DGLFW_BUILD_DOCS=OFF \
        -DGLFW_BUILD_TESTS=OFF \
        -DGLFW_BUILD_EXAMPLES=OFF \
        -DGLFW_BUILD_WAYLAND=OFF \
        -DGLFW_BUILD_X11=ON && \
    cmake --build . --parallel $(nproc) && \
    cmake --install . && \
    rm -rf /opt/deps/src/glfw-libstdc++

# ==== libc++ (clang-18 -stdlib=libc++) ====
# Catch2 v3.6.0 (libc++)
RUN cd /opt/deps/src && \
    git clone --branch v3.6.0 --depth 1 https://github.com/catchorg/Catch2.git catch2-libc++ && \
    cd catch2-libc++ && mkdir build && cd build && \
    CC=/usr/bin/clang-18 CXX=/usr/bin/clang++-18 CXXFLAGS="-stdlib=libc++" \
    cmake .. -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/deps/libc++ -DBUILD_TESTING=OFF && \
    cmake --build . --parallel $(nproc) && \
    cmake --install . && \
    echo 'set(Catch2_SOURCE_DIR "/opt/deps/libc++/src/Catch2")' >> /opt/deps/libc++/lib/cmake/Catch2/Catch2Config.cmake && \
    rm -rf /opt/deps/src/catch2-libc++

# spdlog v1.14.1 (libc++)
RUN cd /opt/deps/src && \
    git clone --branch v1.14.1 --depth 1 https://github.com/gabime/spdlog.git spdlog-libc++ && \
    cd spdlog-libc++ && mkdir build && cd build && \
    CC=/usr/bin/clang-18 CXX=/usr/bin/clang++-18 CXXFLAGS="-stdlib=libc++" \
    cmake .. -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/deps/libc++ -DSPDLOG_BUILD_TESTS=OFF -DSPDLOG_BUILD_EXAMPLE=OFF && \
    cmake --build . --parallel $(nproc) && \
    cmake --install . && \
    rm -rf /opt/deps/src/spdlog-libc++

# fmt v11.0.2 (libc++)
RUN cd /opt/deps/src && \
    git clone --branch 11.0.2 --depth 1 https://github.com/fmtlib/fmt.git fmt-libc++ && \
    cd fmt-libc++ && mkdir build && cd build && \
    CC=/usr/bin/clang-18 CXX=/usr/bin/clang++-18 CXXFLAGS="-stdlib=libc++" \
    cmake .. -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/deps/libc++ -DFMT_TEST=OFF && \
    cmake --build . --parallel $(nproc) && \
    cmake --install . && \
    rm -rf /opt/deps/src/fmt-libc++

# GLFW 3.4 (libc++)
RUN cd /opt/deps/src && \
    git clone --branch 3.4 --depth 1 https://github.com/glfw/glfw.git glfw-libc++ && \
    cd glfw-libc++ && mkdir build && cd build && \
    CC=/usr/bin/clang-18 CXX=/usr/bin/clang++-18 CXXFLAGS="-stdlib=libc++" \
    cmake .. -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/opt/deps/libc++ \
        -DGLFW_BUILD_DOCS=OFF \
        -DGLFW_BUILD_TESTS=OFF \
        -DGLFW_BUILD_EXAMPLES=OFF \
        -DGLFW_BUILD_WAYLAND=OFF \
        -DGLFW_BUILD_X11=ON && \
    cmake --build . --parallel $(nproc) && \
    cmake --install . && \
    rm -rf /opt/deps/src/glfw-libc++

# ==== Header-only (shared for all ABIs) ====
# nlohmann/json v3.11.3
RUN cd /opt/deps/src && \
    git clone --branch v3.11.3 --depth 1 https://github.com/nlohmann/json.git && \
    cd json && mkdir build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/deps/include -DJSON_BuildTests=OFF && \
    cmake --build . --parallel $(nproc) && \
    cmake --install . && \
    rm -rf /opt/deps/src/json

# STB (header-only image library)
RUN cd /opt/deps/src && \
    git clone --depth 1 https://github.com/nothings/stb.git && \
    mkdir -p /opt/deps/include/stb && \
    cp stb/*.h /opt/deps/include/stb/ && \
    rm -rf stb


# Environment variable for dependency resolution
ENV AW_DEPS_DIR=/opt/deps

# fzf keybindings + fd + zoxide + bat integration
# /home/node/workspace is mounted as volume, use /home/node for persistent config
RUN mkdir -p /home/node/.config/zoxide && \
    cat > /home/node/.zshrc <<'ZSHRC'
# fzf keybindings
[ -f /usr/share/fzf/key-bindings.zsh ] && source /usr/share/fzf/key-bindings.zsh
[ -f /usr/share/fzf/completion.zsh ]   && source /usr/share/fzf/completion.zsh

# fd (fdfind)
alias f='fdfind'

# zoxide
eval "$(zoxide init zsh)"

# bat as cat
alias cat='bat'
ZSHRC

RUN chown -R node:node /home/node/.zshrc

# SSH wrapper: /home/node/.ssh is read-only in the base image.
# This script uses a writable /tmp dir for known_hosts and identity files,
# so git push/pull over SSH works without host key verification errors.
# Stored in /usr/local/bin (persistent) instead of /tmp (tmpfs).
RUN cat > /usr/local/bin/git-ssh-wrapper <<'WRAPPER'
#!/bin/sh
mkdir -p /tmp/ssh-home/.ssh
# SSH keys are in /home/node/workspace/.ssh (workspace is volume-mounted)
WORKSPACE_SSH=/home/node/workspace/.ssh
[ -d "$HOME/.ssh" ] && WORKSPACE_SSH="$HOME/.ssh"
cp "$WORKSPACE_SSH/id_ed25519" /tmp/ssh-home/.ssh/id_ed25519 2>/dev/null
cp "$WORKSPACE_SSH/id_ed25519.pub" /tmp/ssh-home/.ssh/id_ed25519.pub 2>/dev/null
ssh-keyscan -t ed25519,rsa github.com 2>/dev/null | grep -v '^#' > /tmp/ssh-home/.ssh/known_hosts 2>/dev/null
ssh-keyscan -t ed25519,rsa gitlab.com 2>/dev/null | grep -v '^#' > /tmp/ssh-home/.ssh/known_hosts.gitlab 2>/dev/null
chmod 600 /tmp/ssh-home/.ssh/id_ed25519 2>/dev/null
chmod 644 /tmp/ssh-home/.ssh/known_hosts 2>/dev/null
chmod 644 /tmp/ssh-home/.ssh/known_hosts.gitlab 2>/dev/null

case "$1" in
  *gitlab.com*)
    KNOWN_HOSTS=/tmp/ssh-home/.ssh/known_hosts.gitlab
    ;;
  *github.com*)
    KNOWN_HOSTS=/tmp/ssh-home/.ssh/known_hosts
    ;;
  *)
    KNOWN_HOSTS=/tmp/ssh-home/.ssh/known_hosts
    ;;
esac

exec /usr/bin/ssh -F /dev/null \
    -i /tmp/ssh-home/.ssh/id_ed25519 \
    -o UserKnownHostsFile="$KNOWN_HOSTS" \
    -o IdentitiesOnly=yes \
    -o StrictHostKeyChecking=yes \
    "$@"
WRAPPER
RUN chmod 755 /usr/local/bin/git-ssh-wrapper

# Git global config: use SSH wrapper for all git operations
# /home/node/workspace is mounted as volume, use /home/node for persistent config
RUN mkdir -p /home/node/.config/git && \
    cat > /home/node/.config/git/config <<'GITCFG'
[user]
    name = Anatoly Ivanov
    email = ai_vibeqodez@vk.com
[core]
    sshCommand = /usr/local/bin/git-ssh-wrapper
    pager = diff-so-fancy | less --tabs=4 -RF
[safe]
    directory = /home/node/workspace
    directory = /home/node/workspace/*
GITCFG
RUN chown -R node:node /home/node/.config

# Set HOME to /home/node so git finds config in /home/node/.config/git/
# /home/node/workspace is volume-mounted, so files there are overwritten on container start
ENV HOME=/home/node/workspace
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV TZ=Asia/Krasnoyarsk
ENV GH_CONFIG_DIR=/home/node/.dsh/gh

RUN mkdir -p "${DSH_HOME}/gh" /home/node/workspace \
    && chown -R node:node "${DSH_HOME}" /home/node/workspace

# 1. Добавляем рантайм-драйверы Mesa (llvmpipe) для работы OpenGL/GLFW в Xvfb
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libgl1-mesa-dri \
        libglx-mesa0 \
        mesa-utils && \
    rm -rf /var/lib/apt/lists/*

# 2. Фиксим запуск Xvfb из deepseek-harness-entrypoint / dsh-browser-desktop:
# убираем заглушку "needs-to-be-defined" и неподдерживаемые флаги +extension
RUN mv /usr/bin/Xvfb /usr/bin/Xvfb.real && \
    cat > /usr/bin/Xvfb <<'EOF'
#!/bin/sh
args=""
has_screen=0
skip_next=0
for arg in "$@"; do
  if [ "$skip_next" = "1" ]; then
    skip_next=0
    continue
  fi
  case "$arg" in
    needs-to-be-defined) ;;
    +extension|-extension) skip_next=1 ;;
    -screen) has_screen=1; args="$args $arg" ;;
    *) args="$args $arg" ;;
  esac
done
if [ "$has_screen" = "0" ]; then
  args="$args -screen 0 1280x720x24"
fi
exec /usr/bin/Xvfb.real $args
EOF
RUN chmod +x /usr/bin/Xvfb

# TDLib (libstdc++) — build for gcc-15/clang-18 default as well
RUN cd /opt/deps/src && \
    git clone --depth 1 https://github.com/tdlib/td.git td-libstdc++ && \
    cd td-libstdc++ && mkdir build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/deps/libstdc++ \
        -DTDLIB_SHARED=OFF -DBUILD_SHARED_LIBS=OFF -DTD_CLI=OFF && \
    cmake --build . --parallel $(nproc) && \
    cmake --install . && \
    rm -rf /opt/deps/src/td-libstdc++

USER node
WORKDIR /home/node/workspace
COPY --from=docker:cli /usr/local/bin/docker /usr/local/bin/docker
